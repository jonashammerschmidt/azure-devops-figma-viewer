{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm install",
      "type": "shell",
      "command": "npm install",
      "problemMatcher": []
    },
    {
      "label": "start dev server",
      "type": "npm",
      "script": "start:dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "webpack .* compiled successfully|compiled successfully"
        }
      }
    },
    {
      "label": "build dev",
      "type": "npm",
      "script": "compile:dev",
      "problemMatcher": []
    },
    {
      "label": "build prod",
      "type": "npm",
      "script": "compile",
      "problemMatcher": []
    },
    {
      "label": "package dev",
      "type": "npm",
      "script": "package:dev",
      "problemMatcher": []
    },
    {
      "label": "package prod",
      "type": "npm",
      "script": "package",
      "problemMatcher": []
    },
    {
      "label": "publish dev",
      "type": "npm",
      "script": "publish:dev",
      "problemMatcher": []
    },
    {
      "label": "publish prod",
      "type": "npm",
      "script": "publish",
      "problemMatcher": []
    }
  ]
}
